PORT=4005

MONGODB_URI=mongodb://127.0.0.1:27017
DB_NAME=hotel_notification

RABBITMQ_URL=amqp://localhost:5672

USER_SERVICE_URL=http://localhost:4001
INTERNAL_SERVICE_SECRET=your_existing_internal_service_secret

# ==============================================================================
# Email Transport Configuration
# ==============================================================================
# EMAIL_TRANSPORT_TYPE: "api" (Brevo HTTPS REST API, recommended) | "smtp" (fallback)
EMAIL_TRANSPORT_TYPE=api

# Primary: Brevo HTTPS REST API (https://api.brevo.com/v3/smtp/email)
BREVO_API_KEY=xkeysib-your_brevo_api_key_here
SENDER_EMAIL=your_verified_sender_email@example.com
SENDER_NAME=PGM Stays
EMAIL_API_TIMEOUT_MS=10000

# Optional Fallback: SMTP Configuration (Nodemailer)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_smtp_login@example.com
SMTP_PASS=your_smtp_key

# Deprecated aliases supported for backward compatibility:
# SMPT_USER=your_smtp_login@example.com
# SMPT_PASS=your_smtp_key

NODE_ENV=development
